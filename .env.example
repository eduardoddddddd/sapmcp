# SAP connection
SAP_ASHOST=your_sap_host
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=RFC_USER
SAP_PASS=********
SAP_LANG=EN

# Optional multi-destination support. The classic SAP_* block above is always
# available as logical destination "default".
# SAPMCP_DESTINATIONS=DEV,QAS,PRD
# SAPMCP_DEFAULT_DESTINATION=DEV
# SAP_DEV_ASHOST=dev_sap_host
# SAP_DEV_SYSNR=00
# SAP_DEV_CLIENT=100
# SAP_DEV_USER=RFC_DEV
# SAP_DEV_PASS=********
# SAP_DEV_LANG=EN
# SAP_QAS_ASHOST=qas_sap_host
# SAP_QAS_SYSNR=00
# SAP_QAS_CLIENT=100
# SAP_QAS_USER=RFC_QAS
# SAP_QAS_PASS=********

# Optional router/string alternatives
# SAP_MSHOST=message_server
# SAP_R3NAME=SID
# SAP_GROUP=PUBLIC
# SAP_SAPROUTER=/H/router.example/H/

# SAP NetWeaver RFC SDK path
# Windows example: C:\nwrfcsdk\lib
# macOS/Linux example: /usr/local/sap/nwrfcsdk/lib
SAP_NWRFC_LIB_DIR=/usr/local/sap/nwrfcsdk/lib
# Or pin exact file:
# SAP_NWRFC_LIB_PATH=/usr/local/sap/nwrfcsdk/lib/libsapnwrfc.dylib

# Safety: read-only by default. Set false only in controlled systems.
SAPMCP_READ_ONLY=true
# Comma-separated RFC allowlist. Supports * wildcard. Empty = use safety defaults.
SAPMCP_ALLOWED_RFC=
# Required for write-like RFCs even if read-only=false.
SAPMCP_ALLOW_DANGEROUS=false
# Limit table wrappers by default.
SAPMCP_MAX_ROWS=200
# Timeout per RFC invoke, in seconds.
SAPMCP_RFC_TIMEOUT=60

# Optional health-check thresholds
# SAPMCP_HC_DUMPS_WARN=5
# SAPMCP_HC_DUMPS_CRIT=20
# SAPMCP_HC_LOCKS_WARN=50
# SAPMCP_HC_LOCKS_CRIT=200
# SAPMCP_HC_UPDATE_PENDING_WARN=1
# SAPMCP_HC_UPDATE_PENDING_CRIT=10
# SAPMCP_HC_UPDATE_ERR_WARN=1
# SAPMCP_HC_UPDATE_ERR_CRIT=1
# SAPMCP_HC_TRFC_WARN=20
# SAPMCP_HC_TRFC_CRIT=100
# SAPMCP_HC_JOBS_ABORTED_WARN=1
# SAPMCP_HC_JOBS_ABORTED_CRIT=5
# SAPMCP_HC_WP_PRIV_WARN=1
# SAPMCP_HC_WP_PRIV_CRIT=2
# SAPMCP_HC_WP_STOPPED_WARN=1
# SAPMCP_HC_WP_STOPPED_CRIT=1

# Optional SNC
# SAP_SNC_MODE=1
# SAP_SNC_LIB=/path/to/libsapcrypto.dylib
# SAP_SNC_QOP=8
# SAP_SNC_MYNAME=p:CN=client, OU=...
# SAP_SNC_PARTNERNAME=p:CN=server, OU=...

# Optional keyring password lookup (requires sapmcp[keyring])
# SAPMCP_USE_KEYRING=false
